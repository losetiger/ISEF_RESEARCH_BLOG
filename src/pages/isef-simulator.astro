---
// src/pages/isef-simulator.astro
---

<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ISEF 答辩模拟修罗场 - 鹏宇科研工作室</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">

    <!-- 顶部导航栏 -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="bg-indigo-600 p-2 rounded-lg text-white">
                <i data-lucide="cpu" class="w-6 h-6"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg tracking-wide">ISEF 答辩模拟修罗场</h1>
                <p class="text-xs text-slate-400">AI 驱动的沉浸式国际科创竞赛评委质询系统</p>
            </div>
        </div>
        <div class="flex items-center space-x-4">
            <button id="settings-btn" class="flex items-center space-x-1.5 text-xs bg-slate-800 hover:bg-slate-700 px-3 py-2 rounded-lg border border-slate-700 transition cursor-pointer">
                <i data-lucide="key" class="w-4 h-4 text-amber-400"></i>
                <span id="key-status-text">配置 API Key</span>
            </button>
            <a href="/" class="text-xs text-slate-400 hover:text-white transition">返回博客首页</a>
        </div>
    </header>

    <!-- 主体区域 -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- 左侧：项目配置面板 -->
        <div class="lg:col-span-1 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between shadow-xl">
            <div class="space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <h2 class="font-semibold text-sm flex items-center space-x-2 text-indigo-400">
                        <i data-lucide="file-text" class="w-4 h-4"></i>
                        <span>1. 输入科研项目资料</span>
                    </h2>
                    <span class="text-[10px] bg-indigo-950 text-indigo-300 px-2 py-0.5 rounded border border-indigo-800">Gemini驱动</span>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-300 mb-1">项目名称 / Title</label>
                    <input type="text" id="proj-title" value="Deep Learning-Based Oral Lesion Classification" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500">
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-300 mb-1">学科赛道 / Category</label>
                    <select id="proj-category" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500">
                        <option value="ROBO">机器人与智能机电 (ROBO)</option>
                        <option value="CS">嵌入式系统与人工智能 (SOFT/CS)</option>
                        <option value="BMED" selected>生物医学与健康工程 (BMED)</option>
                        <option value="ENEV">环境工程与可持续发展 (ENEV)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-300 mb-1">研究摘要与核心创新点 / Abstract</label>
                    <textarea id="proj-abstract" rows="6" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 resize-none">To provide a reliable diagnostic answer without explanation, we integrated Grad-CAM (Gradient-weighted Class Activation Mapping). It generates a heatmap that shows which areas of the image the model focused on, making the system more transparent for medical professionals to trust in practice.</textarea>
                </div>
            </div>

            <div class="pt-4 border-t border-slate-800 mt-4">
                <button id="start-btn" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3 rounded-xl text-sm transition shadow-lg shadow-indigo-600/20 flex items-center justify-center space-x-2 cursor-pointer">
                    <i data-lucide="play" class="w-4 h-4"></i>
                    <span>召集评委天团，开启答辩</span>
                </button>
            </div>
        </div>

        <!-- 右侧：答辩主视窗 -->
        <div class="lg:col-span-2 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 flex flex-col h-[700px] shadow-xl">
            <!-- 状态栏与评委信息 -->
            <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
                <div class="flex items-center space-x-3">
                    <div id="judge-avatar" class="w-10 h-10 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-indigo-400 font-bold">
                        <i data-lucide="users" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 id="judge-name" class="font-semibold text-sm text-slate-200">等待开启答辩</h3>
                        <p id="judge-title" class="text-xs text-slate-400">请在左侧填写项目并点击开始</p>
                    </div>
                </div>
                <div id="timer-box" class="hidden items-center space-x-2 bg-amber-500/10 border border-amber-500/30 text-amber-400 px-3 py-1.5 rounded-lg text-xs font-mono">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                    <span id="countdown">02:00</span>
                </div>
            </div>

            <!-- 聊天对话框 -->
            <div id="chat-container" class="flex-1 overflow-y-auto space-y-4 pr-2 text-sm">
                <div class="bg-slate-950/50 border border-slate-800/80 rounded-xl p-4 text-slate-400 text-center flex flex-col items-center justify-center h-full space-y-3">
                    <i data-lucide="shield-alert" class="w-8 h-8 text-indigo-500 animate-pulse"></i>
                    <p>欢迎来到 ISEF 答辩模拟环境。<br>配置好你的 Gemini API Key，填写项目摘要后，即可召唤 3 位评委大牛进行实战质询！</p>
                </div>
            </div>

            <!-- 底部输入框 -->
            <div class="pt-4 border-t border-slate-800 mt-4 flex items-center space-x-3">
                <input type="text" id="user-input" disabled placeholder="请等待评委提问后在此输入你的应答..." class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 disabled:opacity-50">
                <button id="send-btn" disabled class="bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white px-5 py-3 rounded-xl text-sm transition flex items-center space-x-1 cursor-pointer">
                    <span>发送应答</span>
                    <i data-lucide="send" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

    </main>

    <!-- API Key 配置弹窗 -->
    <div id="settings-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-semibold text-base text-slate-100 flex items-center space-x-2">
                    <i data-lucide="key" class="w-5 h-5 text-amber-400"></i>
                    <span>配置 Gemini API Key</span>
                </h3>
                <button id="close-modal" class="text-slate-400 hover:text-white cursor-pointer"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <p class="text-xs text-slate-400">请输入你的 Gemini API Key（仅保存在浏览器的 LocalStorage 中，安全可靠）。</p>
            <div>
                <input type="password" id="api-key-input" placeholder="AIzaSy..." class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500">
            </div>
            <div class="flex justify-end space-x-3 pt-2">
                <button id="save-key-btn" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl text-xs transition cursor-pointer">保存 Key</button>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        // 确保 DOM 加载完成后再绑定事件
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();

            const settingsBtn = document.getElementById('settings-btn');
            const settingsModal = document.getElementById('settings-modal');
            const closeModal = document.getElementById('close-modal');
            const saveKeyBtn = document.getElementById('save-key-btn');
            const apiKeyInput = document.getElementById('api-key-input');
            const keyStatusText = document.getElementById('key-status-text');

            let apiKey = localStorage.getItem('gemini_api_key') || '';
            if(apiKey) {
                keyStatusText.textContent = "API Key 已配置";
                apiKeyInput.value = apiKey;
            }

            settingsBtn.addEventListener('click', () => settingsModal.classList.remove('hidden'));
            closeModal.addEventListener('click', () => settingsModal.classList.add('hidden'));
            saveKeyBtn.addEventListener('click', () => {
                apiKey = apiKeyInput.value.trim();
                localStorage.setItem('gemini_api_key', apiKey);
                keyStatusText.textContent = apiKey ? "API Key 已配置" : "配置 API Key";
                settingsModal.classList.add('hidden');
            });

            // 答辩核心逻辑
            let currentRound = 1;
            let projectContext = {};
            let chatHistory = [];

            const startBtn = document.getElementById('start-btn');
            const chatContainer = document.getElementById('chat-container');
            const userInput = document.getElementById('user-input');
            const sendBtn = document.getElementById('send-btn');
            const judgeName = document.getElementById('judge-name');
            const judgeTitle = document.getElementById('judge-title');
            const timerBox = document.getElementById('timer-box');

            startBtn.addEventListener('click', async () => {
                const title = document.getElementById('proj-title').value.trim();
                const abstract = document.getElementById('proj-abstract').value.trim();
                
                if(!apiKey) {
                    alert('请先点击右上角配置你的 Gemini API Key！');
                    settingsModal.classList.remove('hidden');
                    return;
                }
                if(!title || !abstract) {
                    alert('请完整填写项目名称和摘要！');
                    return;
                }

                projectContext = { title, abstract };
                chatContainer.innerHTML = '';
                currentRound = 1;
                chatHistory = [];
                timerBox.classList.remove('hidden');
                timerBox.classList.add('flex');
                userInput.disabled = false;
                sendBtn.disabled = false;

                judgeName.textContent = "Dr. Arthur Vance (理论与架构专家)";
                judgeTitle.textContent = "专攻底层算法与逻辑严密性";

                appendMessage("judge", "各位评委好，这是我的项目汇报材料，请多指教。");
                
                // 首次向大模型请求第一轮提问
                await callGeminiAI("请作为第1位评委（理论与架构专家），根据以下科研项目向学生抛出一个极其犀利、专业的首轮质询问题（直接输出问题，不要有多余的客套寒暄）：\n项目名称：" + title + "\n摘要：" + abstract);
            });

            async function callGeminiAI(promptText) {
                appendMessage('loading', '评委正在翻阅资料并构思问题...');
                
                try {
                    // 使用标准的 gemini-2.5-flash 或 gemini-1.5-flash 接口
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{ parts: [{ text: promptText }] }]
                        })
                    });

                    const data = await response.json();
                    // 移除加载提示
                    const loadingMsg = document.getElementById('loading-msg');
                    if(loadingMsg) loadingMsg.remove();

                    if(data.candidates && data.candidates[0].content.parts[0].text) {
                        const aiReply = data.candidates[0].content.parts[0].text;
                        appendMessage('judge-ai', aiReply);
                        chatHistory.push({ role: 'model', parts: [{ text: aiReply }] });
                    } else {
                        throw new Error(data.error?.message || 'API 返回格式错误');
                    }
                } catch (error) {
                    const loadingMsg = document.getElementById('loading-msg');
                    if(loadingMsg) loadingMsg.remove();
                    alert('调用 Gemini API 失败: ' + error.message);
                }
            }

            function appendMessage(sender, text) {
                const div = document.createElement('div');
                if(sender === 'judge') {
                    div.className = "flex justify-end";
                    div.innerHTML = `<div class="bg-indigo-600 text-white rounded-2xl rounded-tr-none px-4 py-2.5 max-w-[80%]">${text}</div>`;
                } else if(sender === 'loading') {
                    div.id = 'loading-msg';
                    div.className = "flex justify-start space-x-2";
                    div.innerHTML = `<div class="w-8 h-8 rounded-full bg-indigo-950 border border-indigo-800 flex items-center justify-center text-indigo-400 shrink-0"><i data-lucide="loader" class="w-4 h-4 animate-spin"></i></div>
                                     <div class="bg-slate-900 border border-slate-800 text-slate-400 italic rounded-2xl rounded-tl-none px-4 py-2.5">${text}</div>`;
                } else {
                    div.className = "flex justify-start space-x-2";
                    div.innerHTML = `<div class="w-8 h-8 rounded-full bg-indigo-950 border border-indigo-800 flex items-center justify-center text-indigo-400 shrink-0"><i data-lucide="shield" class="w-4 h-4"></i></div>
                                     <div class="bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl rounded-tl-none px-4 py-2.5 max-w-[80%]">${text}</div>`;
                }
                chatContainer.appendChild(div);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                lucide.createIcons();
            }

            sendBtn.addEventListener('click', async () => {
                const text = userInput.value.trim();
                if(!text) return;
                appendMessage('judge', text);
                userInput.value = '';

                currentRound++;
                if(currentRound === 2) {
                    judgeName.textContent = "Dr. Elena Rostova (产业与应用专家)";
                    judgeTitle.textContent = "专攻工程落地与泛化性挑战";
                    await callGeminiAI(`学生刚才的回答是: "${text}"。现在请作为第2位评委（产业与应用专家），针对该项目（标题: ${projectContext.title}）在真实场景落地、算力限制或泛化性方面抛出一个尖锐的追问：`);
                } else if(currentRound === 3) {
                    judgeName.textContent = "Prof. Marcus Thorne (伦理与安全审查官)";
                    judgeTitle.textContent = "专攻数据合规、隐私及潜在风险";
                    await callGeminiAI(`学生刚才的回答是: "${text}"。现在请作为第3位评委（伦理与安全审查官），针对该项目的数据集隐私、伦理合规或潜在副作用抛出一个刁钻的质询：`);
                } else {
                    judgeName.textContent = "ISEF 合议庭 (闭门裁决)";
                    judgeTitle.textContent = "正在生成最终评审报告";
                    timerBox.classList.add('hidden');
                    userInput.disabled = true;
                    sendBtn.disabled = true;
                    await callGeminiAI(`答辩已完成。学生最后一轮回答是: "${text}"。请作为合议庭主席，给出最终的评审裁决（评定奖项如 Grand Award 一等奖或二等奖，并给出优缺点总结）：`);
                }
            });
        });
    </script>
</body>
</html>